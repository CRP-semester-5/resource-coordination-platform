# ─────────────────────────────────────────────────────────────────────────────
# ResQ Hub — Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (Database) ───────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Project → Settings → API
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ── JWT / Auth ────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Email / SMTP ──────────────────────────────────────────────────────────────
# Development: Leave SMTP_USER empty to auto-create an Ethereal test account.
#   The service will print preview URLs to the console for each sent email.
# Production:  Set SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS to your provider
#   (e.g. SendGrid: host=smtp.sendgrid.net, port=587, user=apikey, pass=<key>)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=ResQ Hub <noreply@resqhub.local>

# ── Token Expiry ──────────────────────────────────────────────────────────────
EMAIL_VERIFICATION_EXPIRES_MINUTES=60
PASSWORD_RESET_EXPIRES_MINUTES=15

# ── Frontend URL (used in email links) ───────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Service Ports ─────────────────────────────────────────────────────────────
API_GATEWAY_PORT=3000
USER_SERVICE_PORT=3001
ORGANIZATION_SERVICE_PORT=3002
RESOURCE_SERVICE_PORT=3003
REQUEST_SERVICE_PORT=3004
TASK_SERVICE_PORT=3005
VOLUNTEER_SERVICE_PORT=3006
NOTIFICATION_SERVICE_PORT=3007

# ── Node ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
