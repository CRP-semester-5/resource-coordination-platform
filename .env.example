# ── Supabase (Database) ───────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Project → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Direct Postgres connection string (for ORMs like Prisma / Drizzle)
# Found in: Supabase Dashboard → Settings → Database → Connection string
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.your-project-id.supabase.co:5432/postgres

# ── JWT / Auth ────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d

# ── Service Ports ─────────────────────────────────────────────
API_GATEWAY_PORT=3000
USER_SERVICE_PORT=3001
ORGANIZATION_SERVICE_PORT=3002
RESOURCE_SERVICE_PORT=3003
REQUEST_SERVICE_PORT=3004
TASK_SERVICE_PORT=3005
VOLUNTEER_SERVICE_PORT=3006
NOTIFICATION_SERVICE_PORT=3007

# ── Node ──────────────────────────────────────────────────────
NODE_ENV=development
